{
  "swagger": "2.0",
  "info": {
    "title": "Contacts API Documentation",
    "description": "CSE 341 – Contacts routes API documentation",
    "version": "1.0.0"
  },
  "host": "localhost:3000",
  "basePath": "/",
  "schemes": [
    "http"
  ],
  "paths": {
    "/contacts/": {
      "get": {
        "summary": "Get all contacts",
        "description": "Returns an array of all contacts stored in MongoDB.",
        "responses": {
          "200": {
            "description": "List of contacts"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "post": {
        "summary": "Create a new contact",
        "description": "Creates a new contact in MongoDB and returns the inserted id.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "description": "Contact data to create",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ContactInput"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Contact created",
            "schema": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "example": "697bd5e18cdb34d6de7175fe"
                }
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "400": {
            "description": "Validation failed"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/contacts/{id}": {
      "get": {
        "summary": "Get contact by id",
        "description": "Returns a single contact document by MongoDB ObjectId.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Contact id"
          }
        ],
        "responses": {
          "200": {
            "description": "Contact found"
          },
          "400": {
            "description": "Bad Request"
          },
          "404": {
            "description": "Contact not found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "put": {
        "summary": "Update contact by id",
        "description": "Updates an existing contact by MongoDB ObjectId. Returns 204 if updated.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Contact id"
          },
          {
            "name": "body",
            "in": "body",
            "description": "Updated contact data",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ContactInput"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Contact updated successfully"
          },
          "400": {
            "description": "Validation failed"
          },
          "404": {
            "description": "Contact not found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "delete": {
        "summary": "Delete contact by id",
        "description": "Deletes a contact by MongoDB ObjectId. Returns 204 if deleted.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Contact id"
          }
        ],
        "responses": {
          "204": {
            "description": "Contact deleted successfully"
          },
          "400": {
            "description": "Bad Request"
          },
          "404": {
            "description": "Contact not found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
